{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C盘清理工具",
  "version": "0.1.0",
  "identifier": "com.xiaohai1314.cdrivecleaner",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "磁盘清理助手",
        "width": 1040,
        "height": 680,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["../rules.json", "../rules_update.json"],
    "windows": {
      "wix": { "language": ["zh-CN"] },
      "nsis": { "languages": ["SimpChinese"] }
    }
  }
}
