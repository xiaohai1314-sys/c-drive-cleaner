    {
      "key": "defrag",
      "name": "磁盘碎片整理（优化）",
      "tier": "deep",
      "kind": "command",
      "describe": "对系统盘执行优化/碎片整理，机械盘收益明显，SSD 仅做 TRIM",
      "warning": "耗时较长，期间请勿关机",
      "requires_confirm": true,
      "command": [
        "%SystemRoot%\\System32\\defrag.exe",
        "C:",
        "/O"
      ],
      "note": "SSD 上只是执行 TRIM，收益有限"
    },
